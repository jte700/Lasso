<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows counterpart of scripts/extract-drawing-layout.swift.
       Published as a single executable the server spawns, so indexing a
       drawing PDF needs no compiler, no Poppler, and no network. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Lasso.DrawingLayout</RootNamespace>
    <AssemblyName>extract-drawing-layout</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.10" />
  </ItemGroup>

</Project>
